# Copy to .env (git-ignored). NEVER commit real keys.

# --- Primary LLM: any OpenAI-compatible endpoint. Default = Groq (free tier: https://console.groq.com/keys)
LLM_API_KEY=
# Optional second key for the same provider (e.g. a second Groq account): its own daily quota, used when the first is spent or blocked
LLM_API_KEY2=
LLM_API_KEY3=
LLM_BASE_URL=https://api.groq.com/openai/v1
# Model IDs change -- check the provider's model list if you get 404/400.
LLM_MODEL=openai/gpt-oss-120b
LLM_FAST_MODEL=openai/gpt-oss-20b
LLM_VISION_MODEL=qwen/qwen3.8-27b
STT_MODEL=whisper-large-v3-turbo

# --- Fallback LLM (used automatically if primary rate-limits / is down). e.g. OpenRouter, Gemini's OpenAI-compat endpoint
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://openrouter.ai/api/v1
FALLBACK_MODEL=openrouter/free
# FALLBACK_MODEL may list several models, comma separated: each is tried in turn when the one before it fails
# Optional second fallback provider (a different company means a separate quota), e.g. Google AI Studio, free key:
FALLBACK2_API_KEY=
FALLBACK2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
FALLBACK2_MODEL=gemini-3.1-flash-lite,gemini-3.5-flash

# --- LIVE DATA (required by FORGE rules: no dummy data) ---
# Mandi prices: free key from https://data.gov.in  (register -> My Account -> API key). Weather/soil (Open-Meteo) needs no key.
DATA_GOV_API_KEY=
# Run `make check-live` once: it prints the real field names and tells you if these need changing.
MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
# auto | lower | title  (data.gov.in field-name case)
# Optional: URL of a proxy that forwards /resource/<id> to api.data.gov.in (see cloudflare/mandi-proxy.js). Only for hosts data.gov.in blocks.
MANDI_BASE_URL=
MANDI_FILTER_STYLE=lower
# Dated prices up to yesterday: gives the multi-day trend behind SELL_NOW / HOLD.
MANDI_HISTORY_RESOURCE_ID=35985678-0d79-46b4-9ed6-6f13308a1d24

# --- Memory: leave QDRANT_URL empty for in-process (zero setup). Use Qdrant Cloud free tier for persistence.
QDRANT_URL=
QDRANT_API_KEY=
# EMBEDDINGS: hash (offline) | fastembed (pip install fastembed; better semantic search)
EMBEDDINGS=hash

# --- App
DOMAIN=farm
CORS_ORIGINS=http://localhost:5173
# Leave empty to keep POST /api/ingest disabled. Set a long random value to enable it (send as X-Admin-Key).
INGEST_API_KEY=
# Chat requests allowed per client+session per minute (0 = off)
RATE_LIMIT_PER_MIN=20

# Optional: fetch today's plan for these farms at start-up so the first visitor gets a warm cache (Place|Crop; Place|Crop)
WARM_PLACES=
# Optional storage paths (empty = memory only). Defaults keep a small SQLite file under backend/data/cache/
CACHE_DB_PATH=data/cache/http_cache.sqlite
SESSION_DB_PATH=data/cache/sessions.sqlite
SNAPSHOT_DB_PATH=data/cache/snapshots.sqlite

# Optional Telegram bot + watcher (token from @BotFather, /newbot). Empty = bot off. Run one copy per token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
WATCH_INTERVAL_MIN=30
SUBSCRIBER_DB_PATH=data/cache/subscribers.sqlite
